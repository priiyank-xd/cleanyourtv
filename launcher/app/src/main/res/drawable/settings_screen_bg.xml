<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the floating glass sheet behind Launcher settings and its dialogs, as the Settings panel's: a dark tint
     so text stays readable over Home and the panel under it (90% opaque; the Settings panel itself is 60%, SettingsHubActivity.SHEET_TINT), a light
     sheen on top and a thin bright edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E610141E" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#2EFFFFFF" android:centerColor="#0FFFFFFF"
                android:endColor="#08FFFFFF" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
