<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: a Launcher settings row as in the Settings panel: nothing at rest, brighter glass with a bright edge
     while focused (the glow around it is LauncherSettingsActivity.addFocusGlow). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#57FFFFFF" android:endColor="#1FFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
