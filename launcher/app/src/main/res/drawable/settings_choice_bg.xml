<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: liquid glass, as in the Settings panel. A chosen option is a white pill (dark text, from
     settings_choice_text); focus is brighter glass with a bright edge; the rest is plain glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#57FFFFFF" android:endColor="#1FFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#0FFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</selector>
