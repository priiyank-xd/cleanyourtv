<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: liquid glass, as on the LG-style home. Focused is bright glass with a bright edge, selected is glass with a
     blue edge, the rest is plain glass: a light gradient with a thin bright edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#26FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#596EC1FF" android:endColor="#2E6EC1FF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#B36EC1FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#29FFFFFF" android:endColor="#0DFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
